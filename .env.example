# Application
AGENTSCOPE_ENVIRONMENT=development
AGENTSCOPE_DEBUG=false
AGENTSCOPE_LOG_LEVEL=INFO
AGENTSCOPE_API_HOST=0.0.0.0
AGENTSCOPE_API_PORT=8000
AGENTSCOPE_ALLOWED_ORIGINS=["http://localhost:3000"]

# Database
AGENTSCOPE_DATABASE_URL=postgresql+asyncpg://agentscope:agentscope@postgres:5432/agentscope

# Redis
AGENTSCOPE_REDIS_URL=redis://redis:6379/0

# Authentication - replace both values outside local development
AGENTSCOPE_JWT_SECRET=change-me-with-at-least-32-random-characters
AGENTSCOPE_TOKEN_HASH_SECRET=change-me-with-another-32-random-characters
AGENTSCOPE_ACCESS_TOKEN_MINUTES=15
AGENTSCOPE_REFRESH_TOKEN_DAYS=7
AGENTSCOPE_REFRESH_COOKIE_SECURE=false

# Telemetry ingestion safety limits
AGENTSCOPE_INGEST_MAX_BATCH_EVENTS=500
AGENTSCOPE_INGEST_MAX_BATCH_BYTES=2000000
AGENTSCOPE_INGEST_MAX_EVENT_BYTES=256000
AGENTSCOPE_INGEST_MAX_CONTENT_BYTES=64000
AGENTSCOPE_INGEST_MAX_METADATA_BYTES=32000
AGENTSCOPE_INGEST_RATE_LIMIT_PER_MINUTE=600

# Qdrant (used beginning in Phase 9)
AGENTSCOPE_QDRANT_URL=http://qdrant:6333

# LLM providers (used beginning in Phase 4)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Email / observability (future phases)
AGENTSCOPE_EMAIL_FROM=
AGENTSCOPE_OTEL_EXPORTER_ENDPOINT=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

